# JARVIS Mission Control .gitignore

# System files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies
node_modules/

# Logs (keep structure, ignore content)
.mission-control/logs/*.log
!.mission-control/logs/.gitkeep

# Temporary files
*.tmp
*.temp

# Sensitive files
.env
.env.*
*.key
*.pem
credentials.json
secrets/

# Build outputs
dist/
build/
out/

# Large analysis/report PDFs — not part of the template, keep them out of the repo
dashboard/*.pdf

# Test coverage
coverage/
.nyc_output/

# Archive (optional - uncomment to exclude)
# .mission-control/archive/

# Backups (local only)
.backups/

# Operational data — never commit
.mission-control/reports/
.mission-control/archived-tasks/
# Live Telegram bot mapping — deployment-specific (template lives in examples/config/agents.json)
.mission-control/config/agents.json
.mission-control/logs/activity.log
.mission-control/logs/*.log
.mission-control/tasks/*.json
.mission-control/queue/*.json
.mission-control/messages/
.mission-control/*.db
.mission-control/*.db-shm
.mission-control/*.db-wal
.mission-control/.github-sync
JARVIS-DEV.md
